# Dochestra environment template. Copy to .env (not committed):  cp .env.example .env

# --- db (pgvector/pgvector:pg16) ---
POSTGRES_USER=dochestra
# change for anything beyond local use (keep DATABASE_URL below in sync)
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dochestra

# --- web ---
# Host port for the web UI. The isolated verification stack (scripts/verify-stack.sh) uses 18080.
WEB_PORT=80

# --- engine ---
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://dochestra:changeme@db:5432/dochestra
EXTRACTOR_URL=http://extractor:8000
# Shared volume mount point (engine and extractor)
DATA_DIR=/data
# Tracing filter
RUST_LOG=info,dochestra_engine=debug
# Compose fixes these for the engine container; uncomment only for local (non-compose) runs:
# ENGINE_BIND=0.0.0.0:8080
# false: skip waiting for the extractor at startup
# EXTRACTOR_HEALTH_REQUIRED=true
# EXTRACTOR_HEALTH_TIMEOUT_SECS=600

# --- extractor ---
# Enable OCR in Docling (needs more CPU/RAM)
EXTRACTOR_OCR=false

# --- external AI (engine) --- [D-6] every call goes through OpenRouter (OpenAI-compatible API)
# With an empty OPENROUTER_API_KEY the engine still starts; only the LLM / embedding / TTS nodes fail.
OPENROUTER_API_KEY=
# default https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# default meta/muse-ember (accepts image input)
LLM_MODEL=
# low | medium | high (default medium)
LLM_EFFORT=
# default baai/bge-m3 (1024 dimensions)
EMBEDDING_MODEL=
# default google/gemini-3.8-flash-lite-tts (returns PCM; the engine encodes MP3)
TTS_MODEL=
# default Kore
TTS_VOICE=
